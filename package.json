{
  "name": "donjon-agent",
  "version": "0.4.0",
  "description": "Portable local agents with Markdown memory and durable Pi execution",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claybowl/donjon-agent.git"
  },
  "bugs": {
    "url": "https://github.com/claybowl/donjon-agent/issues"
  },
  "bin": {
    "donjon-agent": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js"
    },
    "./home": {
      "types": "./dist/home.d.ts",
      "import": "./dist/home.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "MEMORY.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node scripts/executable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:package",
    "test:package": "node scripts/package-smoke.mjs",
    "release:check": "node scripts/release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepublishOnly": "node -e \"console.error('Use GitHub release archives; public registry publishing is disabled.');process.exit(1)\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
